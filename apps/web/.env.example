# Firebase web config (client-side; safe to expose, but keep your own values).
# Get these from Firebase console → Project settings → Your apps → SDK setup.
NEXT_PUBLIC_APIKEY=
NEXT_PUBLIC_AUTHDOMAIN=
NEXT_PUBLIC_PROJECTID=
NEXT_PUBLIC_STORAGEBUCKET=
NEXT_PUBLIC_MESSAGINGSENDERID=
NEXT_PUBLIC_APPID=
NEXT_PUBLIC_MEASUREMENTID=
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Must exactly match a Redirect URI configured in the Spotify developer app.
# Production example: https://yukirhythm-web.vercel.app/library
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/library

# Migration only (scripts/migrate-users-to-uid.ts). Path to a Firebase
# service-account JSON key. NEVER commit the key file itself.
GOOGLE_APPLICATION_CREDENTIALS=

# Server only (Route Handlers). Base64 of the Firebase service-account JSON.
# Generate: Firebase console -> Project settings -> Service accounts -> Generate
# new private key, then: base64 -w0 serviceAccount.json
# NEVER commit the key or this value. Set it in Vercel + .env.local.
FIREBASE_SERVICE_ACCOUNT_B64=

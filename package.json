{
  "name": "yukirhythm",
  "private": true,
  "workspaces": ["apps/web", "packages/*"],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "web": "npm run --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
